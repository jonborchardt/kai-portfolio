---
import "../styles/global.css";
import { Font, Image } from "astro:assets";
import ContactLinks from "../components/ContactLinks.astro";
import { about } from "../lib/assets";
import { CARD_HEIGHT, CARD_WIDTH } from "../lib/card";
import { href } from "../lib/href";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** Site-internal path of the page's share card; the site-wide card if not given. */
  card?: string;
}

const {
  title,
  description = site.description,
  card = "/card.jpg",
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const { contact, portrait } = (await about()).data;

const nav = [
  ["Home", href("/")],
  ["About", href("/about/")],
];
const current = (path: string) =>
  Astro.url.pathname === path ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href(card), Astro.site)} />
    <meta property="og:image:width" content={String(CARD_WIDTH)} />
    <meta property="og:image:height" content={String(CARD_HEIGHT)} />
    <meta property="og:image:alt" content={title ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0e0e0e" />
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-plex-mono" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="top">
      <a class="who" href={href("/")}>
        {portrait && <Image src={portrait} alt="" width={64} height={64} />}
        {site.name}
      </a>
      <nav aria-label="Main">
        {nav.map(([label, path]) => (
          <a href={path} aria-current={current(path)}>
            {label}
          </a>
        ))}
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <span>
        © {new Date().getUTCFullYear()} {site.author}
      </span>
      {contact.length > 0 && (
        <nav aria-label="Contact">
          <ContactLinks links={contact} />
        </nav>
      )}
    </footer>
  </body>
</html>
