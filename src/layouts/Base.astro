---
import "../styles/global.css";
import { CARD_HEIGHT, CARD_WIDTH } from "../lib/card";
import { href } from "../lib/href";
import { site } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** Site-internal path of the page's share card; the site-wide card if not given. */
  card?: string;
}

const {
  title,
  description = site.description,
  card = "/card.jpg",
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/svg+xml" href={href("/favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(href(card), Astro.site)} />
    <meta property="og:image:width" content={String(CARD_WIDTH)} />
    <meta property="og:image:height" content={String(CARD_HEIGHT)} />
    <meta property="og:image:alt" content={title ?? site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Runs before the page is drawn, so a dark page never flashes light. -->
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem("theme") ??
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    </script>
  </head>
  <body class="mx-auto max-w-5xl px-4 py-6">
    <header class="mb-8 flex items-baseline justify-between">
      <a class="text-xl font-bold" href={href("/")}>
        {site.name}
      </a>
      <nav aria-label="Main" class="flex gap-4 underline">
        <a href={href("/")}>Work</a>
        <a href={href("/about/")}>About</a>
        <button
          id="theme-toggle"
          type="button"
          class="cursor-pointer underline"
        >
          <span class="dark:hidden">Dark mode</span>
          <span class="hidden dark:inline">Light mode</span>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const root = document.documentElement;
        const theme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = theme;
        localStorage.setItem("theme", theme);
      });
    </script>
  </body>
</html>
