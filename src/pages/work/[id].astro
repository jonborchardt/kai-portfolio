---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Media from "../../components/Media.astro";
import Base from "../../layouts/Base.astro";
import { resolveMedia } from "../../lib/assets";
import { formatMonthYear } from "../../lib/media";

export async function getStaticPaths() {
  const pieces = await getCollection("work");
  return pieces.map((piece) => ({
    params: { id: piece.id },
    props: { piece },
  }));
}

interface Props {
  piece: CollectionEntry<"work">;
}

const { piece } = Astro.props;
const { title, type, medium, date } = piece.data;
const { Content } = await render(piece);
const media = resolveMedia(piece);
const monthYear = formatMonthYear(date);
const description = [medium, monthYear].filter(Boolean).join(", ");
---

<Base
  title={title}
  description={description}
  card={`/work/${piece.id}/card.jpg`}
>
  <article class="space-y-6">
    <header>
      <h1 class="text-3xl font-bold">{title}</h1>
      <p>
        {type}
        {medium && ` · ${medium}`}
        {" · "}
        <time datetime={date.toISOString().slice(0, 10)}>{monthYear}</time>
      </p>
    </header>
    {media.map((item, index) => (
      <Media media={item} priority={index === 0} />
    ))}
    <div class="prose dark:prose-invert">
      <Content />
    </div>
  </article>
</Base>
