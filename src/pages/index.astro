---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { assertNoOrphanFolders, cover } from "../lib/assets";
import { href } from "../lib/href";
import { byNewest, formatMonthYear } from "../lib/media";

const pieces = (await getCollection("work")).sort(byNewest);
assertNoOrphanFolders(pieces.map((piece) => piece.id));
---

<Base>
  <h1 class="mb-6 text-3xl font-bold">Work</h1>
  {pieces.length === 0 && <p>No work has been added yet.</p>}
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {pieces.map((piece) => {
      const image = cover(piece)?.image;
      return (
        <li>
          <a href={href(`/work/${piece.id}/`)}>
            {/* The title below names the link, so the thumbnail has no alt text to repeat it. */}
            {image && <Image src={image} alt="" width={640} />}
            <h2 class="mt-2 text-xl font-semibold underline">
              {piece.data.title}
            </h2>
          </a>
          <p>
            {piece.data.type}
            {" · "}
            <time datetime={piece.data.date.toISOString().slice(0, 10)}>
              {formatMonthYear(piece.data.date)}
            </time>
          </p>
        </li>
      );
    })}
  </ul>
</Base>
