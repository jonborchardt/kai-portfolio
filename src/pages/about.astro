---
import { render } from "astro:content";
import ContactLinks from "../components/ContactLinks.astro";
import Tile from "../components/Tile.astro";
import Base from "../layouts/Base.astro";
import { about } from "../lib/assets";

const entry = await about();
const { description, contact, images } = entry.data;
const { Content } = await render(entry);
---

<Base title="About" description={description}>
  <article class="doc about">
    <div class="side">
      <h1 class="label">About</h1>
      <div class="prose prose-sm prose-invert">
        <Content />
      </div>
      {contact.length > 0 && (
        <dl>
          <dt>Contact</dt>
          <dd>
            <ContactLinks links={contact} />
          </dd>
        </dl>
      )}
    </div>
    {/* Photos, not links: nothing here opens anything. */}
    {images.length > 0 && (
      <div class="sheet">
        {images.map((image, index) => (
          <Tile index={index} image={image} priority={index === 0} />
        ))}
      </div>
    )}
  </article>
</Base>
