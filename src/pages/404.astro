---
import Base from "../layouts/Base.astro";
import { href } from "../lib/href";
---

<Base title="Page not found">
  <div class="doc">
    <div class="side">
      <h1>Page not found</h1>
      <div class="prose prose-sm prose-invert">
        <p>
          That address has no page. It may have moved, or the link is wrong.
        </p>
      </div>
      <nav class="pn" aria-label="Ways back">
        <a href={href("/")}>
          <span aria-hidden="true">↑ </span>Back to the work
        </a>
      </nav>
    </div>
  </div>
</Base>
